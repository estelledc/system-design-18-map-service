{
  "name": "system-design-18-map-service",
  "version": "0.1.0",
  "description": "Complete-before-current synthetic map builds and frozen route snapshots",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/main.js serve",
    "lint": "node scripts/repo-check.mjs",
    "test": "node --test --test-reporter=spec test/unit/*.test.js",
    "test:infra": "node --test --test-reporter=spec test/integration/*.test.js",
    "smoke:infra": "node scripts/infra-smoke.mjs",
    "benchmark:infra": "node scripts/infra-benchmark.mjs",
    "audit": "npm audit --audit-level=high",
    "check": "npm run lint && npm test && npm run audit",
    "check:ci": "npm run check && npm run test:infra && npm run smoke:infra && npm run benchmark:infra"
  },
  "dependencies": {
    "pg": "8.23.1"
  },
  "keywords": [
    "system-design",
    "map-service",
    "content-addressed-storage",
    "routing",
    "postgresql"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estelledc/system-design-18-map-service.git"
  },
  "bugs": {
    "url": "https://github.com/estelledc/system-design-18-map-service/issues"
  },
  "homepage": "https://github.com/estelledc/system-design-18-map-service#readme",
  "license": "MIT"
}
